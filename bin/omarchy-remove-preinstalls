#!/bin/bash

# omarchy:summary=Remove preinstalled Omarchy applications (web apps, TUIs, and selected packages).

if gum confirm "Are you sure you want to remove all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Removing preinstalled Omarchy applications...\n"

  omarchy-webapp-remove-all
  omarchy-tui-remove-all

  mkdir -p ~/.local/state/omarchy
  touch ~/.local/state/omarchy/preinstalls-removed
  hyprctl reload

  # Remove the mise wrappers omarchy-mise-install wrote. The agents' own
  # installers link the same names, like Claude Code's native install and
  # Cursor's, and anything but the wrapper is the user's to keep.
  for command in codex claude agy copilot gh opencode playwright playwright-cli pi omp ori grok crush ghui hunk cursor-agent muse; do
    wrapper="$HOME/.local/bin/$command"
    if [[ -f $wrapper && ! -L $wrapper ]] && grep -q '^mise use -g' "$wrapper"; then
      rm -f "$wrapper"
    fi
  done

  omarchy-pkg-drop \
    aether \
    cliamp \
    libreoffice-fresh \
    xournalpp \
    pinta \
    obsidian \
    obs-studio \
    kdenlive \
    moonlight-qt \
    lazydocker \
    omacut \
    monologue \
    omacalc \
    omawrite \
    hype
fi
